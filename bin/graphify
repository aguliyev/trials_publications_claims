#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import graphify' >/dev/null 2>&1; then
    echo "Graphify is not available in the active Python environment. Install the pinned development dependencies first:" >&2
    echo "  python3 -m pip install -r ${SCRIPT_DIR}/etc/requirements-dev.txt" >&2
    exit 1
fi

cd "$SCRIPT_DIR"
exec python3 -m graphify "$@"
