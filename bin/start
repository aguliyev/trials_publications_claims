#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

if [ ! -f "etc/.env" ]; then
    echo "Warning: etc/.env not found. Running ./bin/install first..."
    ./bin/install
fi

echo "Starting Workspace services..."
docker compose --env-file etc/.env up -d

echo ""
echo "=== Services Status ==="
docker compose --env-file etc/.env ps

# Load ports from etc/.env if set
JUPYTER_PORT="${JUPYTER_PORT:-8888}"
DJANGO_PORT="${DJANGO_PORT:-8001}"
POSTGRES_HOST_PORT="${POSTGRES_HOST_PORT:-5433}"

if [ -f "etc/.env" ]; then
    eval "$(grep -E '^(JUPYTER_PORT|DJANGO_PORT|POSTGRES_HOST_PORT)=' etc/.env | sed 's/\r//')"
fi

echo ""
echo "=== Access Information ==="
echo "  * JupyterLab:   http://localhost:${JUPYTER_PORT}"
echo "  * Django App:   http://localhost:${DJANGO_PORT}"
echo "  * PostgreSQL:   localhost:${POSTGRES_HOST_PORT} (db: fl_db, user: postgres)"
echo ""
echo "To stop services, run: ./bin/stop"
