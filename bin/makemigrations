#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

if [ ! -f "etc/.env" ]; then
    echo "Error: etc/.env not found. Run ./bin/install first."
    exit 1
fi

docker compose --env-file etc/.env exec django-app python django_app/manage.py makemigrations "$@"
