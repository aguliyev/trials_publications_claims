#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Run this command from a Git working tree." >&2
    exit 1
fi

"$SCRIPT_DIR/bin/graphify" hook install

# Graph data is intentionally local and ignored, so the merge driver installed
# by Graphify has no repository artifact to merge.
git config --local --remove-section merge.graphify || true

if [ -f .gitattributes ]; then
    ATTRIBUTES_TMP="$(mktemp .gitattributes.XXXXXX)"
    grep -Fvx 'graphify-out/graph.json merge=graphify' .gitattributes > "$ATTRIBUTES_TMP" || true
    if [ -s "$ATTRIBUTES_TMP" ]; then
        mv "$ATTRIBUTES_TMP" .gitattributes
    else
        rm "$ATTRIBUTES_TMP" .gitattributes
    fi
fi

HOOK_STATUS="$("$SCRIPT_DIR/bin/graphify" hook status)"
if ! grep -qx 'post-commit: installed' <<<"$HOOK_STATUS" || ! grep -qx 'post-checkout: installed' <<<"$HOOK_STATUS"; then
    printf '%s\n' "$HOOK_STATUS" >&2
    echo "Graphify hooks were not installed successfully." >&2
    exit 1
fi

echo "Graphify Git setup complete."
